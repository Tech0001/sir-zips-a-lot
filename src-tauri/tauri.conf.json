{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sir Zips-a-Lot",
  "version": "0.1.1",
  "identifier": "com.tech0001.sir-zips-a-lot",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sir Zips-a-Lot",
        "width": 980,
        "height": 800,
        "minWidth": 680,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Your orders, zipped and delivered.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
